{
  "name": "packport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "bun": ">=1.3.3",
    "node": ">=22.22.2"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hooks:validate": "lefthook validate",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.13",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  }
}
